# Copy to .env and fill in. Every key is optional: missing ones fall back to mock data.

# Tiger Cloud (Postgres) connection string, from the Tiger console
DATABASE_URL=

# Google AI Studio key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# swarms.world API key
SWARMS_API_KEY=
SWARMS_MODEL=gpt-4o-mini

# Auth0: tenant domain and the API identifier (audience)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

CORS_ORIGINS=http://localhost:3000
