# Copy to .env.local and fill in.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: URL the Next.js server uses to reach FastAPI (defaults to NEXT_PUBLIC_API_URL)
API_URL=

# Auth0 (Regular Web Application). Leave blank to run without login.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# API identifier from Auth0 > APIs (must match AUTH0_AUDIENCE in api/.env)
AUTH0_AUDIENCE=
